{
	"name": "n8n-nodes-meetergo",
	"version": "0.1.0",
	"description": "Official meetergo integration for scheduling, contacts and booking event workflows.",
	"license": "MIT",
	"homepage": "https://meetergo.com",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "meetergo GmbH",
		"email": "support@meetergo.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/DominikRapacki/n8n-nodes-meetergo.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "vitest run",
		"typecheck": "tsc --noEmit --incremental false"
	},
	"files": [
		"dist/credentials",
		"dist/nodes"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MeetergoApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Meetergo/Meetergo.node.js",
			"dist/nodes/Meetergo/MeetergoTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=22.16"
	}
}
